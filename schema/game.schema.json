{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/game.schema.json",
  "title": "Pinball Commentary Game",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "manufacturer",
    "year",
    "metadata",
    "hook",
    "rules",
    "watch",
    "shots",
    "strategy",
    "danger",
    "commentary",
    "trivia",
    "summary",
    "venue_notes",
    "image"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 1930,
      "maximum": 2100
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "designer",
        "artist",
        "production",
        "era",
        "multiball"
      ],
      "properties": {
        "designer": {
          "type": "string"
        },
        "artist": {
          "type": "string"
        },
        "production": {
          "type": "string"
        },
        "era": {
          "type": "string",
          "minLength": 1
        },
        "multiball": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "hook": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "bullets"
      ],
      "properties": {
        "primary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "bullets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "watch": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "value",
          "risk",
          "diagram"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "risk": {
            "type": "string",
            "enum": [
              "Low",
              "Medium",
              "Medium-High",
              "High"
            ]
          },
          "diagram": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["x"]
            },
            "then": {
              "required": ["y"]
            }
          },
          {
            "if": {
              "required": ["y"]
            },
            "then": {
              "required": ["x"]
            }
          }
        ]
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ahead",
        "behind",
        "key_decision"
      ],
      "properties": {
        "ahead": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "behind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "key_decision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "danger": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "commentary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "trivia": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "venue_notes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    },
    "image": {
      "type": "string",
      "pattern": "^images/[A-Za-z0-9._/-]+$"
    }
  }
}